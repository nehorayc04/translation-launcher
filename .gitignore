Cyberpunk 2077/
תרגום_משחקים/
backup_translation_*/
_font_extract_tmp/

# ── build artefacts ──────────────────────────────────────────
build/
dist/
Output/
__pycache__/
*.pyc
*.pyo
*.spec.bak
.venv/
venv/

# ── frontend (Vite) ──────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# ── secrets / runtime ────────────────────────────────────────
.env
.env.*
*.env
~/.translation_manager/
cache.json
*.log
*.log.err
*.runtime.log

# Build-time bake secrets (Supabase URL + anon key). Loaded by
# build_exe.bat → generated into translation_manager/auth/_baked.py
# at PyInstaller time. Both files MUST stay out of git.
.env.build
translation_manager/auth/_baked.py

