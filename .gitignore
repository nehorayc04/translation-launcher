# ── huge / external ──────────────────────────────────────────
# game install (~90 GB), backups, staging
Cyberpunk 2077/
תרגום_משחקים/
backup_translation_*/
_font_extract_tmp/

# ── nested repos (each one tracks itself) ────────────────────
# website/ is the public translation-hub site — its own git repo,
# pushed to github.com/nehorayc04/A-translation-hub. The outer
# repo ignores it entirely.
website/

# ── build artefacts ──────────────────────────────────────────
build/
dist/
Output/
__pycache__/
*.pyc
*.pyo
*.spec.bak
.venv/
venv/

# ── frontend (Vite) ──────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# ── secrets / runtime ────────────────────────────────────────
.env
.env.*
*.env
translation_manager/auth/_baked.py
translation_manager/_build_info.py
~/.translation_manager/
cache.json
*.log

# ── local dev tooling / private notes ────────────────────────
.claude/
.playwright-mcp/
CLAUDE_PRIVATE.md
*.lnk
*.log.err
*.runtime.log

# ── large media ──────────────────────────────────────────────
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.mp3
*.m4a
*.wav
*.flac
*.opus

# ── binaries / archives ──────────────────────────────────────
*.apk
*.aab
*.ipa
*.dex
*.exe
*.dll
*.zip
*.7z
*.rar
*.tar.gz
*.archive
*.archive.WITH_FONTS_BROKEN
*.bak

# ── large data files (translation working sets) ──────────────
localization_translated.json
missing_translations_queue.json
lm_translation_progress.json
lm_output.json
*_decompiled/

# ── editor / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ── timestamped backups, locks, transient tmp files ─────────
# Translation pipeline scripts spray .bak.<timestamp> sidecars and
# short-lived lock files; none of them belong in version control.
*.bak.*
*.bak[0-9]*
*_backup.acl
*.acl.bak
*.lock
_tmp_*
*_giveup.json

# ── extra credentials / runtime secrets (defence in depth) ──
.env.build
.env.local
.env.production
*.pem
*.p12
*.pfx
*.cer
*.key
credentials.json
secrets.json
service-account.json
.npmrc

# ── PyInstaller / Inno Setup transient ──────────────────────
*.spec~
warn-*.txt
xref-*.html

# ── node_modules anywhere in the tree (catch-all) ───────────
node_modules/

# Local dev-build counter (baked into _build_info.py per build)
_dev_build.txt

# ── translation working data / corpus / mod payloads (2026-06-29) ──
# These are large DERIVED artifacts (translation spines, queues, audit
# dumps, binary mod payloads) — never source. Keep them out of the repo.
*.jsonl
*.modular
*.stage
*.localization
*.loc
*.wad
*.rpf
*.gxt2
*.ffd
*.xbt
*.fnt
*.bak_*
*.bak_pre_*
*.he_backup
games/*/work/*.json
games/*/work/*.xml
games/*/extract/
games/*/release/*.zip

# ── vendored third-party tool repos (re-cloneable; not our source) ──
games/*/tools/ALERT/
games/*/tools/Overstrike/
games/*/tools/FFDConverter/
games/*/tools/Gibbed.Disrupt/
games/*/tools/watch-dogs-loc-tool/
games/*/tools/WatchDogs2-File-Lists/
games/*/tools/loctool/
games/*/tools/ffdconverter/
games/*/tools/atk_src/
games/*/tools/anvil_src/
